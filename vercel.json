{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/project",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/projects/fabric-data-engineering",
      "destination": "/projects/microsoft-fabric-end-to-end-data-pipeline",
      "permanent": true
    },
    {
      "source": "/projects/car-sales-dashboard",
      "destination": "/projects/power-bi-car-sales-analytics-dashboard",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|avif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
